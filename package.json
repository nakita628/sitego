{
  "name": "sitego-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "deps": "mkdir -p /tmp/pnpm-store && pnpm config set store-dir /tmp/pnpm-store &&rm -rf node_modules && rm -rf pnpm-lock.yaml && rm -rf ~/.pnpm-store && pnpm store prune && pnpm install --no-prefer-frozen-lockfile",
    "check": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "test": "vp test",
    "build": "pnpm -F sitego build"
  },
  "dependencies": {
    "sitego": "link:packages/sitego",
    "sitego-monorepo": "link:"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vite-plus": "^0.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "sitego-monorepo": "link:",
      "sitego": "link:packages/sitego"
    }
  }
}
