{
  "name": "sitego",
  "version": "0.0.3",
  "description": "Fetch HTML and convert to Markdown",
  "license": "MIT",
  "bin": {
    "sitego": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "release": "npm pkg fix && pnpm build && npm publish"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsdown": "^0.21.7"
  }
}
